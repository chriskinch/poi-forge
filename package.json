{
    "name": "poi-forge",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Generate, edit, animate and preview tile-map points of interest. Saves Tiled-native .tmj/.tsj.",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite --configLoader bundle",
        "start": "vite --configLoader bundle",
        "build": "vite build --configLoader bundle",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "demo:build": "tsx scripts/build-demo.ts",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
        "e2e": "node e2e/smoke.mjs"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
